   "metadata": {},
   "outputs": [],
   "source": [
    "# KPI 1: Monthly Revenue (Optimized for Publication)\n",
    "plt.figure(figsize=(14, 6)) 
    "\n",
    "x = [str(p) for p in kpi_results['monthly_revenue'].index]\n",
    "y = kpi_results['monthly_revenue'].values\n",
    "\n",
    "plt.plot(x, y, marker='o', color=COLORS[0], linewidth=2.5, markersize=8, label='Revenue', zorder=3)\n",
    "\n",
    "plt.fill_between(x, y, alpha=0.15, color=COLORS[0], zorder=2)\n",
    "\n",
    "ymax, ymin = max(y), min(y)\n",
    "xpos_max, xpos_min = x[list(y).index(ymax)], x[list(y).index(ymin)]\n",
    "\n",
    "plt.annotate(f'Peak: {ymax:,.0f} JOD', xy=(xpos_max, ymax), xytext=(0, 10),\n",
    "             textcoords='offset points', ha='center', fontweight='bold', color='green')\n",
    "plt.annotate(f'Low: {ymin:,.0f} JOD', xy=(xpos_min, ymin), xytext=(0, -15),\n",
    "             textcoords='offset points', ha='center', fontweight='bold', color='red')\n",
    "\n",
    "avg_revenue = sum(y) / len(y)\n",
    "plt.axhline(avg_revenue, color='gray', linestyle='--', alpha=0.5, label=f'Avg: {avg_revenue:,.0f}')\n",
    "\n",
    "plt.title(\"Monthly Revenue Trend (JOD)\", fontsize=14, pad=20)\n",
    "plt.xlabel(\"Month\", fontsize=12)\n",
    "plt.ylabel(\"Revenue (JOD)\", fontsize=12)\n",
    "plt.xticks(rotation=90) \n",
    "plt.grid(axis='y', linestyle=':', alpha=0.6)\n",
    "plt.legend(loc='upper left')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"output/kpi1_monthly_revenue_final.png\", dpi=300) \n",
    "plt.close()"
   ]
  },
